{
  "components": {
    "schemas": {
      "CompleteUploadRequest": {
        "additionalProperties": false,
        "properties": {
          "parts": {
            "items": {
              "$ref": "#/components/schemas/CompletedUploadPart"
            },
            "minItems": 1,
            "title": "Parts",
            "type": "array"
          },
          "upload_id": {
            "minLength": 1,
            "title": "Upload Id",
            "type": "string"
          }
        },
        "required": [
          "upload_id",
          "parts"
        ],
        "title": "CompleteUploadRequest",
        "type": "object"
      },
      "CompletedUploadPart": {
        "additionalProperties": false,
        "properties": {
          "etag": {
            "minLength": 1,
            "title": "Etag",
            "type": "string"
          },
          "part_number": {
            "minimum": 1.0,
            "title": "Part Number",
            "type": "integer"
          }
        },
        "required": [
          "part_number",
          "etag"
        ],
        "title": "CompletedUploadPart",
        "type": "object"
      },
      "CreateJobRequest": {
        "additionalProperties": false,
        "properties": {
          "size_bytes": {
            "exclusiveMinimum": 0.0,
            "maximum": 104857600.0,
            "title": "Size Bytes",
            "type": "integer"
          },
          "source_type": {
            "$ref": "#/components/schemas/SourceType"
          }
        },
        "required": [
          "source_type",
          "size_bytes"
        ],
        "title": "CreateJobRequest",
        "type": "object"
      },
      "CreateJobResponse": {
        "additionalProperties": false,
        "properties": {
          "job": {
            "$ref": "#/components/schemas/Job"
          },
          "upload_id": {
            "title": "Upload Id",
            "type": "string"
          },
          "upload_parts": {
            "items": {
              "$ref": "#/components/schemas/UploadPartAuthorization"
            },
            "title": "Upload Parts",
            "type": "array"
          }
        },
        "required": [
          "job",
          "upload_id",
          "upload_parts"
        ],
        "title": "CreateJobResponse",
        "type": "object"
      },
      "DownloadResponse": {
        "additionalProperties": false,
        "properties": {
          "download_url": {
            "title": "Download Url",
            "type": "string"
          }
        },
        "required": [
          "download_url"
        ],
        "title": "DownloadResponse",
        "type": "object"
      },
      "ExportRequest": {
        "additionalProperties": false,
        "properties": {
          "acknowledged": {
            "title": "Acknowledged",
            "type": "boolean"
          }
        },
        "required": [
          "acknowledged"
        ],
        "title": "ExportRequest",
        "type": "object"
      },
      "FailureCode": {
        "description": "Safe failure classifications that may be persisted and returned.",
        "enum": [
          "analyze_transient",
          "analyze_spot_interrupted",
          "render_transient",
          "render_spot_interrupted",
          "validation_failed",
          "unsupported_content",
          "processing_failed"
        ],
        "title": "FailureCode",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Job": {
        "additionalProperties": false,
        "description": "Persistent owner-scoped job record.",
        "properties": {
          "completed_pages": {
            "minimum": 0.0,
            "title": "Completed Pages",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "failure_code": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FailureCode"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Id",
            "type": "string"
          },
          "model_versions": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Model Versions",
            "type": "object"
          },
          "output_key": {
            "minLength": 1,
            "title": "Output Key",
            "type": "string"
          },
          "owner_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Owner Id",
            "type": "string"
          },
          "page_count": {
            "maximum": 200.0,
            "minimum": 0.0,
            "title": "Page Count",
            "type": "integer"
          },
          "source_key": {
            "minLength": 1,
            "title": "Source Key",
            "type": "string"
          },
          "source_type": {
            "$ref": "#/components/schemas/SourceType"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "owner_id",
          "source_type",
          "source_key",
          "output_key",
          "status",
          "page_count",
          "completed_pages",
          "created_at",
          "expires_at",
          "model_versions",
          "version"
        ],
        "title": "Job",
        "type": "object"
      },
      "JobStatus": {
        "description": "Persistent states in the job lifecycle.",
        "enum": [
          "uploading",
          "queued",
          "analyzing",
          "ready",
          "exporting",
          "complete",
          "failed",
          "expired"
        ],
        "title": "JobStatus",
        "type": "string"
      },
      "PageManifest": {
        "additionalProperties": false,
        "description": "Versioned per-page suggestions and current redaction selections.",
        "properties": {
          "job_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Job Id",
            "type": "string"
          },
          "last_saved_at": {
            "format": "date-time",
            "title": "Last Saved At",
            "type": "string"
          },
          "page_number": {
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Page Number",
            "type": "integer"
          },
          "regions": {
            "items": {
              "$ref": "#/components/schemas/RedactionRegion"
            },
            "title": "Regions",
            "type": "array"
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/RedactionRegion"
            },
            "title": "Suggestions",
            "type": "array"
          },
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "job_id",
          "page_number",
          "suggestions",
          "regions",
          "version",
          "last_saved_at"
        ],
        "title": "PageManifest",
        "type": "object"
      },
      "PagePreview": {
        "additionalProperties": false,
        "description": "Short-lived authorization for one rasterized review page.",
        "properties": {
          "height": {
            "exclusiveMinimum": 0.0,
            "title": "Height",
            "type": "integer"
          },
          "page_number": {
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Page Number",
            "type": "integer"
          },
          "preview_url": {
            "minLength": 1,
            "title": "Preview Url",
            "type": "string"
          },
          "width": {
            "exclusiveMinimum": 0.0,
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "page_number",
          "width",
          "height",
          "preview_url"
        ],
        "title": "PagePreview",
        "type": "object"
      },
      "PageSummary": {
        "additionalProperties": false,
        "description": "Frontend summary for one reviewable page.",
        "properties": {
          "height": {
            "exclusiveMinimum": 0.0,
            "title": "Height",
            "type": "integer"
          },
          "manifest_version": {
            "minimum": 1.0,
            "title": "Manifest Version",
            "type": "integer"
          },
          "page_number": {
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Page Number",
            "type": "integer"
          },
          "preview_url": {
            "minLength": 1,
            "title": "Preview Url",
            "type": "string"
          },
          "selected_count": {
            "minimum": 0.0,
            "title": "Selected Count",
            "type": "integer"
          },
          "suggestion_count": {
            "minimum": 0.0,
            "title": "Suggestion Count",
            "type": "integer"
          },
          "width": {
            "exclusiveMinimum": 0.0,
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "page_number",
          "width",
          "height",
          "suggestion_count",
          "selected_count",
          "manifest_version",
          "preview_url"
        ],
        "title": "PageSummary",
        "type": "object"
      },
      "RedactionRegion": {
        "additionalProperties": false,
        "description": "Normalized page-space rectangle selected for redaction.",
        "properties": {
          "category": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Category",
            "type": "string"
          },
          "confidence": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "height": {
            "exclusiveMinimum": 0.0,
            "maximum": 1.0,
            "title": "Height",
            "type": "number"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Id",
            "type": "string"
          },
          "page_number": {
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Page Number",
            "type": "integer"
          },
          "selected": {
            "title": "Selected",
            "type": "boolean"
          },
          "source": {
            "$ref": "#/components/schemas/RegionSource"
          },
          "width": {
            "exclusiveMinimum": 0.0,
            "maximum": 1.0,
            "title": "Width",
            "type": "number"
          },
          "x": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "X",
            "type": "number"
          },
          "y": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Y",
            "type": "number"
          }
        },
        "required": [
          "id",
          "page_number",
          "x",
          "y",
          "width",
          "height",
          "source",
          "category",
          "selected"
        ],
        "title": "RedactionRegion",
        "type": "object"
      },
      "RegionSource": {
        "description": "Origin of a redaction region.",
        "enum": [
          "automatic",
          "manual"
        ],
        "title": "RegionSource",
        "type": "string"
      },
      "SaveManifestRequest": {
        "additionalProperties": false,
        "properties": {
          "regions": {
            "items": {
              "$ref": "#/components/schemas/RedactionRegion"
            },
            "title": "Regions",
            "type": "array"
          },
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "regions"
        ],
        "title": "SaveManifestRequest",
        "type": "object"
      },
      "SourceType": {
        "description": "Supported source document formats.",
        "enum": [
          "pdf",
          "jpeg",
          "png"
        ],
        "title": "SourceType",
        "type": "string"
      },
      "UploadPartAuthorization": {
        "additionalProperties": false,
        "properties": {
          "part_number": {
            "title": "Part Number",
            "type": "integer"
          },
          "upload_url": {
            "title": "Upload Url",
            "type": "string"
          }
        },
        "required": [
          "part_number",
          "upload_url"
        ],
        "title": "UploadPartAuthorization",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
